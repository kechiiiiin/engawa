// スマホ制限アプリ試作のサーバー。GUI は使わず、このファイルと wrangler CLI だけで再現する。
// 初回:  npx wrangler d1 create engawa  → 出てきた database_id を下に入れる
//        npx wrangler secret put API_TOKEN          （~/.config/engawa/token の中身）
//        npm run release    （= remote のマイグレーション → deploy。更新のたびにこれで。deploy を先にしない）
// Worker から APNs を送るときだけ（任意）:
//        npx wrangler secret put APNS_KEY   （.p8 の中身）／ APNS_KEY_ID ／ APNS_TEAM_ID
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "engawa",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "engawa",
      // `wrangler d1 create engawa` で作成済み（2026-10-13）
      "database_id": "d2263c45-7b4c-42d6-9f43-79d2fb83733e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APNS_TOPIC": "jp.kechiiiiin.engawa",
    // 開発ビルドなので sandbox
    "APNS_HOST": "api.sandbox.push.apple.com"
  },
  "observability": { "enabled": true }
}

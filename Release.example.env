# TestFlight 配布の設定。これを Release.local.env にコピーして埋める（Release.local.env は gitignore 済み）
#   cp Release.example.env Release.local.env
# fam-echo と同じ API キーを使うので、値は fam-echo から機械的に写せる（画面に出さない）:
#   grep -E '^ASC_(KEY_ID|ISSUER_ID)=' ~/work/fam-echo/ios/Release.local.env > Release.local.env
# 書式は KEY=値 を1行ずつ。値に引用符は要らない。# で始まる行はコメント。

# --- App Store Connect API キー（ユーザとアクセス → 統合 → App Store Connect API → チームキー） ---
# .p8 は ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8 に置く（リポジトリに入れない）
ASC_KEY_ID=
ASC_ISSUER_ID=
# 置き場所を変えたときだけ書く
ASC_KEY_PATH=
